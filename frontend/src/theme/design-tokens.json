{
  "$schema": "https://reqsys.dev/schemas/design-tokens-v1.json",
  "metadata": {
    "name": "ReqSys DSC Governado",
    "version": "1.0.0",
    "source": "DSC atual corporativo",
    "governance": "padrao-ouro",
    "compatibility": "figmaPadraoOuro"
  },
  "colors": {
    "primary": "#005CA9",
    "primaryDeep": "#003B73",
    "primarySoft": "#E6F0FA",
    "accent": "#F39200",
    "accentDeep": "#B56D00",
    "analytics": "#00B3AD",
    "analyticsDeep": "#007C78",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "critical": "#EF4444",
    "background": "#071526",
    "backgroundDeep": "#03101F",
    "surface": "#0B2038",
    "surfaceElevated": "#102B49",
    "text": "#F8FAFC",
    "muted": "#B8C7D9",
    "border": "rgba(184, 199, 217, 0.24)"
  },
  "radius": {
    "card": "16px",
    "pill": "999px",
    "frame": "24px"
  },
  "typography": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "scale": {
      "xs": "0.6875rem",
      "sm": "0.75rem",
      "md": "0.8125rem",
      "base": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "display": "1.9rem"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px"
  },
  "zIndex": {
    "routeFeedback": 3000,
    "toast": 3500,
    "connectivityAlert": 4000,
    "skipLink": 5000,
    "tooltip": 6000
  },
  "table": {
    "density": "compact",
    "rowFontSize": "0.75rem"
  },
  "semantic": {
    "governance": "primary",
    "executiveHighlight": "accent",
    "informational": "analytics",
    "healthy": "success",
    "degraded": "warning",
    "criticalState": "critical"
  }
}
