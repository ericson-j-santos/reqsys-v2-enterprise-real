{
    "name": "reqsys-enterprise-frontend",
    "version": "3.1.0",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "test": "vitest run",
        "preview": "vite preview --host 0.0.0.0",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:stable": "node scripts/run-e2e-safe.js --reporter=line",
        "setup:msal-state": "node scripts/setup-msal-storage-state.mjs",
        "check:msal-state": "node scripts/check-msal-state.mjs",
        "test:msal-state": "node --test scripts/check-msal-state.test.mjs",
        "test:readiness": "node --test scripts/frontend-readiness-gate.test.mjs",
        "readiness:frontend": "node scripts/frontend-readiness-gate.mjs",
        "validate:design-tokens": "node scripts/validate-design-tokens.mjs",
        "test:design-token-usage": "node --test scripts/validate-design-token-usage.test.mjs",
        "validate:design-token-usage": "node scripts/validate-design-token-usage.mjs",
        "validate:linguagem-simples": "node scripts/validate-user-facing-language.mjs",
        "test:linguagem-simples": "node --test scripts/validate-user-facing-language.test.mjs",
        "test:tooltip-a11y": "node --test scripts/validate-tooltip-accessible-name.test.mjs",
        "validate:tooltip-a11y": "node scripts/validate-tooltip-accessible-name.mjs",
        "test:wcag22-guard": "vitest run src/accessibility/__tests__/wcag22Guard.test.js",
        "validate:wcag22-evidence": "node scripts/validate-wcag22-evidence.mjs",
        "validate:wcag22-formal": "node scripts/validate-wcag22-formal-readiness.mjs",
        "export:figma-tokens": "node scripts/export-figma-tokens.mjs",
        "check:figma-token-drift": "npm run export:figma-tokens && git diff --exit-code -- artifacts/figma-tokens",
        "quality:design-system": "npm run validate:design-tokens && npm run check:figma-token-drift && npm run test:design-token-usage && npm run validate:design-token-usage && npm run build",
        "quality:linguagem-simples": "npm run test:linguagem-simples && npm run validate:linguagem-simples",
        "quality:acessibilidade": "npm run test:tooltip-a11y && npm run validate:tooltip-a11y && npm run test:wcag22-guard"
    },
    "dependencies": {
        "@azure/msal-browser": "^5.18.0",
        "@mdi/font": "^7.4.47",
        "@vitejs/plugin-vue": "^6.0.8",
        "axios": "^1.19.0",
        "mermaid": "^11.16.1",
        "pinia": "^4.0.2",
        "vite": "^8.2.1",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "vuetify": "^4.1.8"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.2",
        "@playwright/test": "^1.59.1",
        "@vitest/coverage-v8": "^4.1.8",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^29.1.1",
        "vitest": "^4.1.8"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "undici": "7.29.0"
    }
}
