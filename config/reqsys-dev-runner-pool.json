{
  "schema_version": 1,
  "pool": "reqsys-dev-pc-pool-v1",
  "environment": "dev",
  "minimum_online_runners": 2,
  "runner_labels": [
    "self-hosted",
    "Windows",
    "X64",
    "reqsys-dev",
    "reqsys-dev-pool-v1"
  ],
  "forbidden_environments": ["hml", "stg", "prod", "production"],
  "required_safeguards": {
    "hml_enabled": false,
    "stg_enabled": false,
    "production_enabled": false,
    "automatic_retry_enabled": false
