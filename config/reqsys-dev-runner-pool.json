  "profiles": {
    "base": {
      "capabilities": ["git", "python", "reqsys-source"],
      "tools": ["git", "python"]
    },
    "runtime": {
      "capabilities": ["git", "python", "docker", "reqsys-source", "dev-runtime"],
      "tools": ["git", "python", "docker"]
    },
    "ollama": {
      "capabilities": ["git", "python", "docker", "ollama", "reqsys-source", "dev-runtime"],
      "tools": ["git", "python", "docker", "ollama"]
    }
  },
  "repositories": [
    "ericson-j-santos/reqsys-v2-enterprise-real",
    "ericson-j-santos/engineering-rules",
    "ericson-j-santos/chatgpt-operational-rules"
  ]
}
