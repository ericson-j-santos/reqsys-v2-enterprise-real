{
  "schema_version": "1.0.0",
  "name": "reqsys-credential-environment-control-plane",
  "principles": {
    "stores_secret_values": false,
    "secret_values_must_remain_in_provider": true,
    "default_fail_closed": true,
    "canonical_environment_source": "infra/fly-environments.json"
  },
  "lifecycle": {
    "allowed_status": [
      "REQUESTED",
      "CREATED",
      "BOUND",
      "VALIDATED",
      "ACTIVE",
      "ROTATION_DUE",
      "ROTATED",
      "REVOKED",
      "UNKNOWN"
    ]
  },
  "providers": {
    "fly": {
      "type": "secret_store",
      "stores_values": true
    },
    "github": {
      "type": "secret_store",
      "stores_values": true
    },
    "azure": {
      "type": "identity_provider",
      "stores_values": false
    }
  },
  "credentials": [
    {
      "credential_id": "jwt-secret-dev",
      "kind": "SECRET",
      "provider": "fly",
      "secret_reference": "JWT_SECRET",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "jwt-secret-hml",
      "kind": "SECRET",
      "provider": "fly",
      "secret_reference": "JWT_SECRET",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "jwt-secret-prod",
      "kind": "SECRET",
      "provider": "fly",
      "secret_reference": "JWT_SECRET",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "jwt-issuer",
      "kind": "CONFIG",
      "provider": "fly",
      "secret_reference": "JWT_ISSUER",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "jwt-audience",
      "kind": "CONFIG",
      "provider": "fly",
      "secret_reference": "JWT_AUDIENCE",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "azure-tenant-id",
      "kind": "IDENTIFIER",
      "provider": "fly",
      "secret_reference": "AZURE_TENANT_ID",
      "owner": "reqsys",
      "status": "UNKNOWN"
    },
    {
      "credential_id": "azure-client-id",
      "kind": "IDENTIFIER",
      "provider": "fly",
      "secret_reference": "AZURE_CLIENT_ID",
      "owner": "reqsys",
      "status": "UNKNOWN"
    }
  ],
  "bindings": [
    {
      "credential_id": "jwt-secret-dev",
      "environment": "dev",
      "consumer": "reqsys-api-dev"
    },
    {
      "credential_id": "jwt-secret-hml",
      "environment": "hml",
      "consumer": "reqsys-api-stg"
    },
    {
      "credential_id": "jwt-secret-prod",
      "environment": "prod",
      "consumer": "reqsys-api"
    },
    {
      "credential_id": "jwt-issuer",
      "environment": "dev",
      "consumer": "reqsys-api-dev"
    },
    {
      "credential_id": "jwt-issuer",
      "environment": "hml",
      "consumer": "reqsys-api-stg"
    },
    {
      "credential_id": "jwt-issuer",
      "environment": "prod",
      "consumer": "reqsys-api"
    },
    {
      "credential_id": "jwt-audience",
      "environment": "dev",
      "consumer": "reqsys-api-dev"
    },
    {
      "credential_id": "jwt-audience",
      "environment": "hml",
      "consumer": "reqsys-api-stg"
    },
    {
      "credential_id": "jwt-audience",
      "environment": "prod",
      "consumer": "reqsys-api"
    },
    {
      "credential_id": "azure-tenant-id",
      "environment": "hml",
      "consumer": "reqsys-api-stg"
    },
    {
      "credential_id": "azure-tenant-id",
      "environment": "prod",
      "consumer": "reqsys-api"
    },
    {
      "credential_id": "azure-client-id",
      "environment": "hml",
      "consumer": "reqsys-api-stg"
    },
    {
      "credential_id": "azure-client-id",
      "environment": "prod",
      "consumer": "reqsys-api"
    }
  ]
}
