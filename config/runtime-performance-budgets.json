{
  "schema_version": "1.0.0",
  "policy_version": "2026-08-25.4",
  "description": "Orçamentos de performance, regressão histórica 7/30 dias, SLO/error budget e degradação sustentada do ReqSys. Valores só devem ser recalibrados com evidência histórica.",
  "defaults": {
    "samples": 20,
    "concurrency": 4,
    "warmup": 3,
    "timeout_seconds": 5
  },
  "browser": {
    "max_event_loop_lag_p95_ms": 100,
    "max_event_loop_lag_max_ms": 250,
    "max_long_task_ms": 250,
    "max_lcp_ms": 4000,
    "max_heap_after_gc_mb": 128,
    "max_gc_roundtrip_ms": 750
  },
  "history": {
    "retention_days": 45,
    "windows_days": [7, 30],
    "minimum_baseline_samples": 5,
    "artifact_name_main": "dynamic-performance-evidence-main",
    "block_on_single_regression": false,
    "regression": {
      "max_latency_increase_percent": 30,
      "max_throughput_drop_percent": 30,
      "max_error_rate_increase_pp": 1,
      "max_browser_metric_increase_percent": 30
    }
  },
  "performance_slo": {
    "window_days": 7,
    "minimum_samples": 5,
    "error_budget_warning_remaining_percent": 25,
    "targets": {
      "api_latency_good_percent": 95,
      "api_reliability_good_percent": 99,
      "api_capacity_good_percent": 95,
      "browser_runtime_good_percent": 95
    },
    "sustained_degradation": {
      "required_consecutive": 3,
      "reference_window_days": 7,
      "minimum_reference_samples": 5
    }
  },
  "endpoints": [
    {
      "name": "health",
      "method": "GET",
      "path": "/health",
      "expected_status": 200,
      "budget": {
        "max_p95_ms": 1500,
        "max_p99_ms": 2500,
        "max_error_rate_percent": 0,
        "min_throughput_rps": 2
      }
    },
    {
      "name": "runtime-health",
      "method": "GET",
      "path": "/api/runtime/health",
      "expected_status": 200,
      "budget": {
        "max_p95_ms": 1500,
        "max_p99_ms": 2500,
        "max_error_rate_percent": 0,
        "min_throughput_rps": 2
      }
    },
    {
      "name": "runtime-readiness",
      "method": "GET",
      "path": "/api/runtime/readiness",
      "expected_status": 200,
      "budget": {
        "max_p95_ms": 2000,
        "max_p99_ms": 3500,
        "max_error_rate_percent": 0,
        "min_throughput_rps": 1
      }
    },
    {
      "name": "runtime-liveness",
      "method": "GET",
      "path": "/api/runtime/liveness",
      "expected_status": 200,
      "budget": {
        "max_p95_ms": 1000,
        "max_p99_ms": 1800,
        "max_error_rate_percent": 0,
        "min_throughput_rps": 3
      }
    }
  ]
}
