FROM python:3.12-slim

ARG GITHUB_SHA=unknown
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    GITHUB_SHA=${GITHUB_SHA}

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unixodbc \
        unixodbc-dev \
        tesseract-ocr \
        tesseract-ocr-por \
        poppler-utils \
        imagemagick \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app
COPY ocr_evidencia /app/ocr_evidencia
COPY diagram_generator_portable /app/diagram_generator_portable
COPY copilot_memory_core /app/copilot_memory_core
COPY copilot_memory_powerautomate_complete.py /app/copilot_memory_powerautomate_complete.py
COPY copilot_memory_simple_package.py /app/copilot_memory_simple_package.py
COPY fly_boot.sh /app/fly_boot.sh

RUN sed -i 's/\r$//' /app/fly_boot.sh \
    && chmod +x /app/fly_boot.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/health" || exit 1

ENTRYPOINT ["/app/fly_boot.sh"]
