FROM python:3.12-slim

ARG GITHUB_SHA=unknown
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    GITHUB_SHA=${GITHUB_SHA}

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unixodbc \
        unixodbc-dev \
        tesseract-ocr \
        tesseract-ocr-por \
        poppler-utils \
        imagemagick \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# COPY . . (em vez de uma allowlist explicita por modulo) e proposital: um
# modulo local novo esquecido na allowlist ja crash-loopou este runtime duas
# vezes (ocr_evidencia em 2026-08-24, wsjf_workbook_package em 2026-09-09).
# O que nao deve entrar na imagem fica em .dockerignore.
COPY . .

RUN sed -i 's/\r$//' /app/fly_boot.sh \
    && chmod +x /app/fly_boot.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/health" || exit 1

ENTRYPOINT ["/app/fly_boot.sh"]
