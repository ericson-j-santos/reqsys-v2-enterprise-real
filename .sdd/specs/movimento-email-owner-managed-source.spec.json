{
  "feature_name": "movimento-email-owner-managed-source",
  "project": "ReqSys v2 Enterprise — Prospecção Movimento",
  "created_at": "2026-09-19",
  "phase": "implementation",
  "approvals": {
    "requirements": true,
    "design": true,
    "tasks": true
  },
  "description": "Fonte institucional autogerida e real para o ambiente privado do proprietário, eliminando dependência de time de dados externo. A fonte sintética permanece separada apenas para testes.",
  "runtime_target": "pc24x7-noteri-dev",
  "environment": "DEV",
  "source": {
    "server": "localhost",
    "database": "ReqSysMovimentoOwnerDev",
    "schema": "owner_movimento",
    "authority": "owner_managed",
    "auth": "windows_integrated",
    "synthetic": false,
    "business_seed_embedded": false
  },
  "target": {
    "database": "ReqSysMovimentoDev",
    "schema": "movimento_src"
  },
  "controls": {
    "dev_only": true,
    "no_login_creation": true,
    "no_secret_required": true,
    "idempotent_ingest": "payload_sha256",
    "idempotent_sync": true,
    "production_enabled": false,
    "equivalent_test_source_remains_separate": true
  },
  "data_contract": {
    "datasets": [
      "fechamento_diario",
      "pendencias_cadastro",
      "pendencias_historicas",
      "pendencias_observacao"
    ],
    "ingest_format": "JSON com data_referencia e os quatro datasets",
    "empty_source_is_valid": true
  },
  "sdd_gate": {
    "tests": [
      "tests/test_movimento_email_owner_source.py"
    ],
    "evidence_contract": "Bootstrap físico deve provar banco/schema/views no SQL Server local; ingestão real só conta quando o payload vier de dado operacional real. Fixtures de validação nunca podem ser declaradas como dado corporativo real."
  }
}
