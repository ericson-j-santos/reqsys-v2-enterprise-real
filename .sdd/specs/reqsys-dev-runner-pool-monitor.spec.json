{
  "schema_version": "1.0",
  "feature_name": "ReqSys DEV runner pool monitor",
  "status": "implementation",
  "updated_at": "2026-10-24",
  "approvals": {
    "requirements": true
  },
  "scope": {
    "environment": "dev",
    "minimum_online_runners": 2,
    "execution": "github-hosted observer with two portable self-hosted leases",
    "schedule": "every_30_minutes",
    "mode": "report_only"
  },
  "architecture": {
    "workflow": ".github/workflows/self-hosted-runner-governance-guard.yml",
    "policy": "config/reqsys-dev-runner-pool.json",
    "audit": "scripts/audit_reqsys_dev_runner_pool.py",
    "test": "tests/test_reqsys_dev_runner_pool_monitor.py",
    "observation_credential": "github.token actions:read",
    "observation_source": "current workflow run jobs",
    "new_workflow_surface": false
  },
  "safety": {
    "mutates_runner_registry": false,
    "dispatches_controlled_self_hosted_probes": true,
    "fixed_hostname_or_runner_id": false,
    "automatic_retry": false,
    "deploy": false,
    "hml": false,
    "stg": false,
    "production": false
  },
  "evidence": {
    "artifact": "reqsys-dev-runner-pool-monitor-<run_id>",
    "retention_days": 30,
    "sanitized": true,
    "degraded_job_conclusion": "failure",
    "finding_types": [
      "probe_jobs_missing",
      "probe_unassigned",
      "probe_incomplete",
      "probe_failed",
      "runner_labels_mismatch",
      "probe_runner_reused",
      "insufficient_online_runners"
    ]
  },
  "sdd_gate": {
    "tests": [
      "tests/test_reqsys_dev_runner_pool_monitor.py",
      "tests/test_self_hosted_runner_governance.py"
    ],
    "evidence_contract": "O monitor deve reutilizar o workflow canônico de governança, observar em infraestrutura GitHub-hosted dois leases concorrentes enviados por labels portáteis, provar dois runners distintos pelos jobs da própria execução com github.token/actions:read e falhar o job de auditoria quando a evidência estiver degradada, sem endpoint administrativo, PAT pessoal, mutação, deploy, retry automático ou contato com HML, STG e PROD."
  },
  "traceability": {
    "requirements": ".sdd/specs/reqsys-dev-runner-pool-monitor.requirements.md",
    "runbook": "docs/runbooks/reqsys-dev-runner-pool.md"
  }
}
