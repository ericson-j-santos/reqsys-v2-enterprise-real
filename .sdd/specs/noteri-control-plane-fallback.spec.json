{
  "schema_version": "1.0",
  "feature_name": "Noteri control-plane fallback without RDC",
  "status": "code_ready_activation_pending",
  "approvals": {
    "requirements": true
  },
  "architecture": {
    "external_gateway": ".github/workflows/reqsys-authorized-actions-gateway.yml",
    "self_hosted_workflow": ".github/workflows/noteri-control-plane-probe.yml",
    "probe": "scripts/noteri_control_plane_probe.py",
    "watchdog": "scripts/noteri_control_plane_watchdog.py",
    "bootstrap": "scripts/activate_noteri_free_control_plane.py",
    "runner_labels": [
      "self-hosted",
      "Windows",
      "X64",
      "noteri",
      "reqsys-dev"
    ],
    "rdc_required": false,
    "environment": "DEV",
    "headless_runner_name": "NoteriHeadless",
    "headless_runner_home": "C:\\actions-runner-noteri-headless",
    "headless_runner_labels": [
      "self-hosted",
      "Windows",
      "X64",
      "noteri-headless",
      "reqsys-dev"
    ],
    "headless_runtime": "native_windows_service"
  },
  "security": {
    "arbitrary_shell": false,
    "gui_input": false,
    "secrets_stored": false,
    "production": false,
    "reboot": false,
    "fail_closed_on_missing_runner": true,
    "elevated_result_contains_secrets": false
  },
  "runtime_gate": {
    "prerequisite": "GitHub CLI autenticado e bootstrap governado capaz de provisionar ou reutilizar o runner do Noteri",
    "activation_pending_until": [
      "native GitHub runner Windows service proven",
      "NoteriHeadless Runner.Listener.exe proven",
      "headless service workflow pickup proven"
    ],
    "unavailable_error": "SELF_HOSTED_RUNNER_UNAVAILABLE",
    "abandoned_run_cleanup": "cancel_exact_run_and_record_terminal_state"
  },
  "sdd_gate": {
    "tests": [
      "tests/test_noteri_control_plane_fallback.py",
      "tests/test_reqsys_authorized_actions_gateway.py",
      "tests/test_self_hosted_runner_governance.py",
      "tests/test_activate_noteri_free_control_plane.py"
    ],
    "evidence_contract": "O runner interativo deve permanecer funcional durante a migração; o headless só é aceito após serviço Windows nativo do GitHub Runner ativo, pickup real no runner NoteriHeadless, artifact sanitizado, replay idempotente e controle negativo de identidade."
  },
  "traceability": {
    "requirements": ".sdd/specs/noteri-control-plane-fallback.requirements.md",
    "workflow": ".github/workflows/noteri-control-plane-probe.yml",
    "gateway": ".github/workflows/reqsys-authorized-actions-gateway.yml",
    "probe": "scripts/noteri_control_plane_probe.py",
    "watchdog": "scripts/noteri_control_plane_watchdog.py",
    "bootstrap": "scripts/activate_noteri_free_control_plane.py",
    "policy": ".github/self-hosted-runner-policy.json",
    "abandoned_run_cleanup": ".github/workflows/reqsys-authorized-actions-gateway.yml",
    "headless_service_probe": ".github/workflows/noteri-headless-service-probe.yml"
  },
  "artifacts": {
    "headless_activation_workflow": ".github/workflows/noteri-headless-control-plane-activation.yml",
    "headless_service_probe_workflow": ".github/workflows/noteri-headless-service-probe.yml",
    "native_service_bootstrap": "scripts/activate_noteri_free_control_plane.py",
    "legacy_s4u_launcher_deprecated": "scripts/noteri_control_plane_watchdog_uac_launcher.py"
  },
  "commands": {
    "headless_activation": "/reqsys run noteri-headless-control-plane-activation",
    "headless_service_probe": "/reqsys run noteri-headless-service-probe"
  },
  "runtime_acceptance": {
    "headless_service": {
      "type": "windows_service",
      "provisioner": "GitHub Actions Runner config.cmd --runasservice",
      "runner_name": "NoteriHeadless",
      "runner_home": "C:\\actions-runner-noteri-headless",
      "labels": [
        "self-hosted",
        "Windows",
        "X64",
        "noteri-headless",
        "reqsys-dev"
      ],
      "service_account": "GitHub Runner default NetworkService",
      "password_supplied": false,
      "validator": "windows_scm",
      "required_state": [
        "service_exists",
        "auto_start",
        "running"
      ],
      "uac_bypass_allowed": false,
      "local_interactive_fallback": {
        "staged_by": "GitHub self-hosted runner Noteri",
        "desktop_files": [
          "Ativar-Noteri-Headless.cmd",
          "Ativar-Noteri-Headless.ps1"
        ],
        "purpose": "single-click legitimate UAC consent for initial native Windows service provisioning",
        "rdc_required": false
      }
    },
    "legacy_s4u": {
      "accepted_for_headless": false,
      "reason": "Task Scheduler S4U has no network access and cannot satisfy GitHub runner connectivity"
    },
    "probe_workflow": {
      "host": "Noteri",
      "runner_name": "NoteriHeadless",
      "shell": "powershell",
      "forbidden_shell": "pwsh",
      "reason": "Noteri self-hosted runner exposes Windows PowerShell; PowerShell 7 (pwsh) is not required"
    }
  }
}
