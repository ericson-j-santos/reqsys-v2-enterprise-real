{
  "schema_version": "1.1",
  "feature_name": "Noteri to Desktop network and WMI read-only probe",
  "status": "implementation",
  "issue": 1899,
  "increment_type": "gap_fix",
  "architecture": {
    "source_host": "Noteri",
    "target_host": "DESKTOP-PDQK954",
    "workflow": ".github/workflows/noteri-desktop-network-probe.yml",
    "probe": "scripts/noteri_desktop_network_probe.py",
    "gateway": ".github/workflows/reqsys-authorized-actions-gateway.yml",
    "execution_control": "Session Launcher -> Command Gateway",
    "runner_labels": [
      "self-hosted",
      "Windows",
      "X64",
      "noteri",
      "reqsys-dev"
    ],
    "runtime_port": 8081,
    "environment": "DEV",
    "admin_staging_probe": "C:\\Users\\Public\\Desktop via C$",
    "wmi": {
      "transport": "DCOM/WMI",
      "namespace": "root\\cimv2",
      "query_class": "Win32_OperatingSystem",
      "query": "SELECT Caption FROM Win32_OperatingSystem",
      "credentials": "current Windows identity only",
      "read_only": true
    }
  },
  "security": {
    "arbitrary_target": false,
    "arbitrary_shell": false,
    "remote_shell": false,
    "gui_input": false,
    "credentials_supplied": false,
    "credentials_read": false,
    "firewall_change": false,
    "reboot": false,
    "shutdown": false,
    "raw_ip_persisted": false,
    "remote_write": false,
    "remote_listing_persisted": false,
    "wmi_mutation": false
  },
  "evidence_contract": {
    "states": [
      "name_resolution_failed",
      "resolved_not_reachable",
      "host_reachable_runtime_port_closed",
      "host_reachable_wmi_runtime_port_closed",
      "runtime_port_reachable"
    ],
    "wmi_states": [
      "accessible",
      "empty_result",
      "access_denied",
      "rpc_server_unavailable",
      "namespace_unavailable",
      "dependency_unavailable",
      "wmi_error"
    ],
    "artifact": "artifacts/noteri-desktop-network/evidence.json",
    "correlation_id_required": true,
    "independent_readback_required": true,
    "exact_sha_required": true,
    "remote_write": false
  },
  "sdd_gate": {
    "tests": [
      "tests/test_noteri_desktop_network_probe.py",
      "tests/test_reqsys_authorized_actions_gateway.py",
      "tests/test_self_hosted_runner_governance.py"
    ],
    "requirements": ".sdd/specs/noteri-desktop-network-probe.requirements.md"
  },
  "approvals": {
    "requirements": true
  },
  "updated_at": "2026-09-24"
}
