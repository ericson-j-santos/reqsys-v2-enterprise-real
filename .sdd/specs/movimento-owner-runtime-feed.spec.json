{
  "feature_name": "movimento-owner-runtime-feed",
  "project": "ReqSys v2 Enterprise — Prospecção Movimento",
  "created_at": "2026-09-19",
  "phase": "implementation",
  "approvals": {
    "requirements": true,
    "design": true,
    "tasks": true
  },
  "description": "Projeta telemetria operacional real do runtime ReqSys DEV para owner_movimento.fechamento_diario, sem fabricar pendências de negócio.",
  "source": {
    "runtime_base": "http://127.0.0.1:8081",
    "endpoints": [
      "/api/health",
      "/api/runtime/health"
    ],
    "environment": "DEV",
    "synthetic": false
  },
  "mapping": {
    "fechamento_diario": [
      "reqsys_api_status",
      "reqsys_runtime_status",
      "reqsys_runtime_status_raw",
      "reqsys_runtime_risk_score",
      "reqsys_runtime_uptime_seconds",
      "reqsys_runtime_score_global",
      "reqsys_runtime_pending_items",
      "reqsys_runtime_blocked_items"
    ],
    "pendencias_cadastro": "empty_until_semantic_source_exists",
    "pendencias_historicas": "empty_until_semantic_source_exists",
    "pendencias_observacao": "empty_until_semantic_source_exists"
  },
  "controls": {
    "explicit_non_business_label": true,
    "fail_closed_on_missing_metric": true,
    "owner_ingest_idempotent_sha256": true,
    "no_pii": true,
    "production_enabled": false
  },
  "sdd_gate": {
    "tests": [
      "tests/test_movimento_owner_runtime_projector.py"
    ],
    "evidence_contract": "Comprovar captura de valores reais do runtime, ingest owner-managed, sync DEV, replay noop e leitura independente; não classificar telemetria como transação comercial."
  }
}
