{
  "schema_version": "1.0",
  "feature_name": "Desktop RDC self-hosted recovery",
  "status": "ready_for_validation",
  "approvals": {
    "requirements": true
  },
  "marker_compatibility": {
    "headless_allowed": [
      "// RDC_HEADLESS_V2_PRIMARY_OWNER",
      "// RDC_HEADLESS_V3_READY_CLAIM"
    ],
    "interactive_allowed": [
      "REM RDC_LAUNCHER_V3_RESILIENT",
      "REM RDC_LAUNCHER_V4_ARBITRATED",
      "REM RDC_LAUNCHER_V5_READY_CLAIM"
    ],
    "unknown_marker_policy": "fail_closed"
  },
  "recovery_execution": {
    "task_restart_sequence": [
      "end",
      "run"
    ],
    "end_failure_policy": "continue_when_task_not_running",
    "run_failure_policy": "fail_closed",
    "evidence_fields": [
      "end_returncode",
      "run_returncode"
    ]
  },
  "sdd_gate": {
    "tests": [
      "tests/test_pc24x7_rdc_recovery.py",
      "tests/test_reqsys_authorized_actions_gateway.py"
    ]
  },
  "traceability": {
    "requirements": ".sdd/specs/desktop-rdc-selfhosted-recovery.requirements.md",
    "workflow": ".github/workflows/desktop-rdc-recovery.yml",
    "recovery_script": "scripts/pc24x7_rdc_recovery.py",
    "authorized_gateway": ".github/workflows/reqsys-authorized-actions-gateway.yml"
  }
}
