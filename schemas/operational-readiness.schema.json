{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqsys.local/schemas/operational-readiness.schema.json",
  "title": "ReqSys Operational Readiness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "capabilities"],
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "source", "description"],
      "properties": {
        "required": {"type": "boolean"},
        "source": {"type": "string", "enum": ["env", "static"]},
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "configured": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "env"}}},
          "then": {"required": ["references"]}
        },
        {
          "if": {"properties": {"source": {"const": "static"}}},
          "then": {"required": ["configured"]}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "environment": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "excel": {"$ref": "#/$defs/capability"},
        "sql_server": {"$ref": "#/$defs/capability"},
        "sharepoint": {"$ref": "#/$defs/capability"},
        "power_automate": {"$ref": "#/$defs/capability"},
        "planner": {"$ref": "#/$defs/capability"},
        "teams": {"$ref": "#/$defs/capability"},
        "microsoft_identity": {"$ref": "#/$defs/capability"}
      }
    }
  }
}
