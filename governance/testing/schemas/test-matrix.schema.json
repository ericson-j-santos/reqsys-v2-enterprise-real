{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqsys.local/schemas/testing/test-matrix.schema.json",
  "title": "ReqSys Quality Fabric Test Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_profile",
    "mode",
    "profiles",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "default_profile": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "report-only",
        "enforced"
      ]
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "suites"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "suites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "cwd",
          "command",
          "timeout_seconds",
          "always_run",
          "paths",
          "evidence_kind"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "always_run": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "unit",
              "unit-integration",
              "integration",
              "build",
              "e2e",
              "contract",
              "security",
              "governance"
            ]
          }
        }
      }
    }
  }
}
