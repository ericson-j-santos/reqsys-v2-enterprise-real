{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.2.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "ReqSys",
    "websiteUrl": "https://github.com/ericson-j-santos/reqsys-v2-enterprise-real",
    "privacyUrl": "https://github.com/ericson-j-santos/reqsys-v2-enterprise-real",
    "termsOfUseUrl": "https://github.com/ericson-j-santos/reqsys-v2-enterprise-real"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "ReqSys Teams Gateway",
    "full": "ReqSys Teams Messaging Gateway"
  },
  "description": {
    "short": "Integra o ReqSys a conversas e notificacoes no Microsoft Teams.",
    "full": "Bot do ReqSys usado pelo Teams Messaging Gateway para mensagens proativas 1:1 e continuidade bidirecional das conversas gerenciadas pela Central de Conversas de IA."
  },
  "accentColor": "#5B3CC4",
  "bots": [
    {
      "botId": "${{TEAMS_BOT_APP_ID}}",
      "scopes": [
        "personal",
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "token.botframework.com"
  ],
  "webApplicationInfo": {
    "id": "${{TEAMS_BOT_APP_ID}}",
    "resource": "https://reqsys-rsc"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        }
      ]
    }
  }
}
