<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>TR_CRIAR_DOSSIES_TREINO</name><description>Autentica, cria dossiê sintético e registra evidência.</description><extended_description>Transformação funcional inferida; chamada pelo job JB_TREINO_CRIAR_DOSSIES.</extended_description><trans_version>2.0.0-treino</trans_version><trans_status>0</trans_status><directory>/</directory>
    <parameters>
      <parameter><name>API_BASE_URL</name><default_value>http://127.0.0.1:8080</default_value><description>Base da API</description></parameter>
      <parameter><name>CLIENT_ID</name><default_value>cliente-treinamento</default_value><description>Cliente sintético</description></parameter>
      <parameter><name>CLIENT_SECRET</name><default_value>segredo-exclusivo-de-treino</default_value><description>Segredo sintético</description></parameter>
      <parameter><name>ARQUIVO_ENTRADA</name><default_value>${Internal.Transformation.Filename.Directory}/../../exemplos/demandas.csv</default_value><description>Demandas sintéticas</description></parameter>
      <parameter><name>DIRETORIO_SAIDA</name><default_value>${Internal.Transformation.Filename.Directory}/../../saida</default_value><description>Diretório de evidências</description></parameter>
    </parameters>
    <log><trans-log-table><connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/><field><id>ID_BATCH</id><enabled>Y</enabled><name>ID_BATCH</name></field></trans-log-table></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>1000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>Y</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>1000</step_performance_capturing_size_limit><dependencies/><partitionschemas/><slaveservers/><clusterschemas/>
  </info>
  <step>
    <name>LER_DEMANDAS</name><type>CsvInput</type><description>Dados somente sintéticos.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><filename>${ARQUIVO_ENTRADA}</filename><filename_field/><rownum_field/><include_filename>N</include_filename><separator>;</separator><enclosure>&quot;</enclosure><header>Y</header><buffer_size>50000</buffer_size><lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding>
    <fields><field><name>demanda_id</name><type>String</type><format/><currency/><decimal/><group/><length>50</length><precision>-1</precision><trim_type>both</trim_type></field><field><name>tipo_servico</name><type>String</type><format/><currency/><decimal/><group/><length>80</length><precision>-1</precision><trim_type>both</trim_type></field><field><name>data_referencia</name><type>Date</type><format>yyyy-MM-dd</format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field><field><name>simular_falha</name><type>String</type><format/><currency/><decimal/><group/><length>1</length><precision>-1</precision><trim_type>both</trim_type></field></fields><GUI><xloc>64</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>PREPARAR_CONTEXTO</name><type>ScriptValueMod</type><description>Valida a demanda, cria correlação e contratos JSON.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>preparar</jsScript_name><jsScript_script><![CDATA[
if (demanda_id == null || String(demanda_id).trim().length == 0) throw "DEMANDA_ID_OBRIGATORIO";
if (tipo_servico == null || String(tipo_servico).trim().length == 0) throw "TIPO_SERVICO_OBRIGATORIO";
var instante_inicio_ms = java.lang.System.currentTimeMillis();
var correlation_id = java.util.UUID.randomUUID().toString();
var digest = java.security.MessageDigest.getInstance("SHA-256");
var chave = String(demanda_id) + "|" + new java.text.SimpleDateFormat("yyyy-MM-dd").format(data_referencia);
var bytes = digest.digest(new java.lang.String(chave).getBytes("UTF-8"));
var sb = new java.lang.StringBuilder();
for (var i=0; i<bytes.length; i++) sb.append(java.lang.String.format("%02x", java.lang.Integer.valueOf(bytes[i] & 0xff)));
var idempotency_key = sb.toString();
var json_auth = JSON.stringify({client_id:String(getVariable("CLIENT_ID", "cliente-treinamento")), client_secret:String(getVariable("CLIENT_SECRET", ""))});
var json_dossie = JSON.stringify({demanda_id:String(demanda_id), tipo_servico:String(tipo_servico), data_referencia:String(new java.text.SimpleDateFormat("yyyy-MM-dd").format(data_referencia)), simular_falha:String(simular_falha).toUpperCase()=="S"});
var url_auth = getVariable("API_BASE_URL", "http://127.0.0.1:8080") + "/oauth/token";
var url_dossie = getVariable("API_BASE_URL", "http://127.0.0.1:8080") + "/v1/dossies";
]]></jsScript_script></jsScript></jsScripts>
    <fields><field><name>correlation_id</name><rename>correlation_id</rename><type>String</type><length>36</length><precision>-1</precision><replace>N</replace></field><field><name>idempotency_key</name><rename>idempotency_key</rename><type>String</type><length>64</length><precision>-1</precision><replace>N</replace></field><field><name>json_auth</name><rename>json_auth</rename><type>String</type><length>2000</length><precision>-1</precision><replace>N</replace></field><field><name>json_dossie</name><rename>json_dossie</rename><type>String</type><length>4000</length><precision>-1</precision><replace>N</replace></field><field><name>url_auth</name><rename>url_auth</rename><type>String</type><length>500</length><precision>-1</precision><replace>N</replace></field><field><name>url_dossie</name><rename>url_dossie</rename><type>String</type><length>500</length><precision>-1</precision><replace>N</replace></field><field><name>instante_inicio_ms</name><rename>instante_inicio_ms</rename><type>Integer</type><length>15</length><precision>0</precision><replace>N</replace></field></fields><GUI><xloc>240</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>SOLICITAR_CREDENCIAL</name><type>Rest</type><description>POST sintético de autenticação.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><method>POST</method><url/><urlInField>Y</urlInField><urlField>url_auth</urlField><bodyField>json_auth</bodyField><httpLogin/><httpPassword/><proxyHost/><proxyPort/><preemptive>N</preemptive><trustStoreFile/><trustStorePassword/><headers><header><field>correlation_id</field><name>X-Correlation-Id</name></header></headers><parameters/><result><name>resposta_auth</name><code>status_auth</code><response_time>duracao_auth_ms</response_time><response_header>cabecalhos_auth</response_header></result><GUI><xloc>448</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>EXTRAIR_CREDENCIAL</name><type>JsonInput</type><description>Extrai somente o token necessário; ele não será persistido.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile><IsIgnoreEmptyFile>N</IsIgnoreEmptyFile><doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull><rownum_field/><file><name/></file><fields><field><name>access_token</name><path>$.access_token</path><type>String</type><format/><currency/><decimal/><group/><length>2048</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field></fields><readurl>N</readurl><removeSourceField>N</removeSourceField><IsInFields>Y</IsInFields><IsAFile>N</IsAFile><valueField>resposta_auth</valueField><shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/><uriNameField/><rootUriNameField/><extensionFieldName/><sizeFieldName/><GUI><xloc>640</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>VALIDAR_AUTENTICACAO</name><type>FilterRows</type><description>Somente HTTP 200 com token segue para criação.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><send_true_to>MONTAR_AUTORIZACAO</send_true_to><send_false_to>CLASSIFICAR_FALHA_AUTH</send_false_to><compare><condition><negated>N</negated><leftvalue>status_auth</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>200</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition></compare><GUI><xloc>832</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>CRIAR_DOSSIE</name><type>Rest</type><description>Criação do dossiê sintético com correlação e idempotência.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><method>POST</method><url/><urlInField>Y</urlInField><urlField>url_dossie</urlField><bodyField>json_dossie</bodyField><httpLogin/><httpPassword/><proxyHost/><proxyPort/><preemptive>N</preemptive><trustStoreFile/><trustStorePassword/><headers><header><field>authorization_header</field><name>Authorization</name></header><header><field>correlation_id</field><name>X-Correlation-Id</name></header><header><field>idempotency_key</field><name>Idempotency-Key</name></header></headers><parameters/><result><name>resposta_dossie</name><code>status_dossie</code><response_time>duracao_dossie_ms</response_time><response_header>cabecalhos_dossie</response_header></result><GUI><xloc>1040</xloc><yloc>112</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>MONTAR_AUTORIZACAO</name><type>ScriptValueMod</type><description>Gera o header em memória.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>header</jsScript_name><jsScript_script><![CDATA[var authorization_header = "Bearer " + String(access_token);]]></jsScript_script></jsScript></jsScripts><fields><field><name>authorization_header</name><rename>authorization_header</rename><type>String</type><length>2200</length><precision>-1</precision><replace>N</replace></field></fields><GUI><xloc>1016</xloc><yloc>208</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>EXTRAIR_ID_DOSSIE</name><type>JsonInput</type><description>Extrai o identificador da resposta.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile><IsIgnoreEmptyFile>N</IsIgnoreEmptyFile><doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull><rownum_field/><file><name/></file><fields><field><name>dossie_id</name><path>$.dossie_id</path><type>String</type><format/><currency/><decimal/><group/><length>80</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field></fields><readurl>N</readurl><removeSourceField>N</removeSourceField><IsInFields>Y</IsInFields><IsAFile>N</IsAFile><valueField>resposta_dossie</valueField><shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/><uriNameField/><rootUriNameField/><extensionFieldName/><sizeFieldName/><GUI><xloc>1232</xloc><yloc>112</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>CLASSIFICAR_RESULTADO</name><type>ScriptValueMod</type><description>Normaliza o estado final sem persistir credencial ou payload integral.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>resultado</jsScript_name><jsScript_script><![CDATA[
var situacao = (Number(status_dossie) == 201 && dossie_id != null && String(dossie_id).length > 0) ? "DOSSIE_CRIADO" : ((Number(status_dossie) >= 400 && Number(status_dossie) < 500) ? "CRIACAO_RECUSADA" : "FALHA_TECNICA");
var status_http = Number(status_dossie);
var duracao_total_ms = java.lang.System.currentTimeMillis() - Number(instante_inicio_ms);
var instante = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX").format(new java.util.Date());
]]></jsScript_script></jsScript></jsScripts><fields><field><name>instante</name><rename>instante</rename><type>String</type><length>40</length><precision>-1</precision><replace>N</replace></field><field><name>situacao</name><rename>situacao</rename><type>String</type><length>40</length><precision>-1</precision><replace>N</replace></field><field><name>status_http</name><rename>status_http</rename><type>Integer</type><length>3</length><precision>0</precision><replace>N</replace></field><field><name>duracao_total_ms</name><rename>duracao_total_ms</rename><type>Integer</type><length>15</length><precision>0</precision><replace>N</replace></field></fields><GUI><xloc>1424</xloc><yloc>112</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>CLASSIFICAR_FALHA_AUTH</name><type>ScriptValueMod</type><description>Converte falha de autenticação em evidência governada.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>falha_auth</jsScript_name><jsScript_script><![CDATA[
var instante = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX").format(new java.util.Date());
var situacao = "AUTENTICACAO_RECUSADA";
var status_http = Number(status_auth);
var dossie_id = null;
var duracao_total_ms = java.lang.System.currentTimeMillis() - Number(instante_inicio_ms);
]]></jsScript_script></jsScript></jsScripts><fields><field><name>instante</name><rename>instante</rename><type>String</type><length>40</length><precision>-1</precision><replace>N</replace></field><field><name>situacao</name><rename>situacao</rename><type>String</type><length>40</length><precision>-1</precision><replace>N</replace></field><field><name>status_http</name><rename>status_http</rename><type>Integer</type><length>3</length><precision>0</precision><replace>N</replace></field><field><name>dossie_id</name><rename>dossie_id</rename><type>String</type><length>80</length><precision>-1</precision><replace>N</replace></field><field><name>duracao_total_ms</name><rename>duracao_total_ms</rename><type>Integer</type><length>15</length><precision>0</precision><replace>N</replace></field></fields><GUI><xloc>1040</xloc><yloc>304</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>GRAVAR_EVIDENCIA</name><type>TextFileOutput</type><description>Arquivo delimitado, sem segredos ou payloads completos.</description><distribute>Y</distribute><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><separator>;</separator><enclosure>&quot;</enclosure><enclosure_forced>N</enclosure_forced><enclosure_fix_disabled>N</enclosure_fix_disabled><header>Y</header><footer>N</footer><format>DOS</format><compression>None</compression><encoding>UTF-8</encoding><endedLine/><fileNameInField>N</fileNameInField><fileNameField/><create_parent_folder>Y</create_parent_folder><file><name>${DIRETORIO_SAIDA}/evidencias_pentaho</name><is_command>N</is_command><servlet_output>N</servlet_output><do_not_open_new_file_init>N</do_not_open_new_file_init><extention>csv</extention><append>Y</append><split>N</split><haspartno>N</haspartno><add_date>N</add_date><add_time>N</add_time><SpecifyFormat>N</SpecifyFormat><date_time_format/><add_to_result_filenames>Y</add_to_result_filenames><pad>N</pad><fast_dump>N</fast_dump><splitevery>0</splitevery></file><fields><field><name>instante</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>correlation_id</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>demanda_id</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>situacao</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>status_http</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>0</precision></field><field><name>dossie_id</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>-1</precision></field><field><name>duracao_total_ms</name><type>Integer</type><format>0</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>-1</length><precision>0</precision></field></fields><GUI><xloc>1632</xloc><yloc>208</yloc><draw>Y</draw></GUI>
  </step>
  <order>
    <hop><from>LER_DEMANDAS</from><to>PREPARAR_CONTEXTO</to><enabled>Y</enabled></hop>
