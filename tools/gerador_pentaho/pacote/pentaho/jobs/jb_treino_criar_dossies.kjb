<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>JB_TREINO_CRIAR_DOSSIES</name>
  <description>Orquestra a transformação sintética de criação de dossiês.</description>
  <extended_description>Inferido a partir de evidência visual. Não contém configuração corporativa.</extended_description>
  <job_version>2.0.0-treino</job_version>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>treinamento</created_user>
  <created_date>2026/08/10 00:00:00.000</created_date>
  <modified_user>treinamento</modified_user>
  <modified_date>2026/08/10 00:00:00.000</modified_date>
  <parameters>
    <parameter><name>ARQUIVO_CONFIGURACAO</name><default_value>${Internal.Job.Filename.Directory}/../config/treino.properties</default_value><description>Arquivo de parâmetros sintéticos</description></parameter>
    <parameter><name>MAX_TENTATIVAS_JOB</name><default_value>2</default_value><description>Quantidade máxima de execuções da transformação</description></parameter>
  </parameters>
  <entries>
    <entry>
      <name>START</name><description>Entrada especial que o Kitchen localiza pelo nome literal "START" (JobMeta.STRING_SPECIAL_START).</description><type>SPECIAL</type><start>Y</start><dummy>N</dummy><repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth><parallel>N</parallel><draw>Y</draw><xloc>96</xloc><yloc>160</yloc>
    </entry>
    <entry>
      <name>VALIDAR_CONFIGURACAO</name><description>Falha cedo se parâmetros obrigatórios estiverem ausentes.</description><type>TRANS</type>
      <specification_method>filename</specification_method><filename>${Internal.Job.Filename.Directory}/../transformacoes/tr_validar_configuracao.ktr</filename><transname/><directory>/</directory><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><parallel>N</parallel><draw>Y</draw><xloc>288</xloc><yloc>160</yloc>
    </entry>
    <entry>
      <name>PROCESSAR_DOSSIES</name><description>Executa a transformação principal.</description><type>TRANS</type>
      <specification_method>filename</specification_method><filename>${Internal.Job.Filename.Directory}/../transformacoes/tr_criar_dossies_treino.ktr</filename><transname/><directory>/</directory><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><parallel>N</parallel><draw>Y</draw><xloc>496</xloc><yloc>160</yloc>
    </entry>
    <entry>
      <name>FIM_COM_SUCESSO</name><description/><type>SUCCESS</type><parallel>N</parallel><draw>Y</draw><xloc>720</xloc><yloc>112</yloc>
    </entry>
    <entry>
      <name>FIM_COM_FALHA</name><description>Interrompe o job preservando evidência de falha.</description><type>ABORT</type><message>Falha governada no fluxo de criação de dossiês. Consulte as evidências.</message><always_log_rows>N</always_log_rows><parallel>N</parallel><draw>Y</draw><xloc>720</xloc><yloc>240</yloc>
    </entry>
  </entries>
  <hops>
    <hop><from>START</from><to>VALIDAR_CONFIGURACAO</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>VALIDAR_CONFIGURACAO</from><to>PROCESSAR_DOSSIES</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>VALIDAR_CONFIGURACAO</from><to>FIM_COM_FALHA</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>PROCESSAR_DOSSIES</from><to>FIM_COM_SUCESSO</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>PROCESSAR_DOSSIES</from><to>FIM_COM_FALHA</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads>
    <notepad><note>JOB: parametrização, validação, execução e encerramento governado.</note><xloc>64</xloc><yloc>48</yloc><width>640</width><heigth>40</heigth><fontname>Segoe UI</fontname><fontsize>10</fontsize><fontbold>Y</fontbold><fontitalic>N</fontitalic><fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue><backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>255</backgroundcolorgreen><backgroundcolorblue>204</backgroundcolorblue><bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue><drawshadow>Y</drawshadow></notepad>
  </notepads>
</job>

